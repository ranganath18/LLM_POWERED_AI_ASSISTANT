# Copy this file to .env and fill in your own values. NEVER commit .env.
# On Render, add these as Environment Variables instead of using a file.

# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_api_key_here
# The Groq model to use
GROQ_MODEL=openai/gpt-oss-120b

# Websites allowed to call the API, comma-separated (no trailing slash).
# Local default works with the Vite dev server. In production use your Vercel URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL connection string. When set, chats are stored there;
# leave it commented out to use a local SQLite file instead (local development).
# Use the "Session pooler" string from Supabase -> Connect (works from Render).
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: where the local SQLite file lives (only used when DATABASE_URL is empty)
# SQLITE_PATH=data/chat.db

# Archived (and deleted) chats are permanently removed after this many days (default 30)
# ARCHIVE_RETENTION_DAYS=30
